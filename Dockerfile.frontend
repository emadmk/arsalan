# Build stage
FROM node:18-alpine AS builder

WORKDIR /app

# Set Node.js memory limit to prevent OOM errors
ENV NODE_OPTIONS="--max-old-space-size=2048"

# Install build dependencies for native modules (required for rollup on Alpine)
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# Install dependencies with npm install to properly handle optional dependencies in Alpine
# npm ci has issues with rollup's optional dependencies on Alpine Linux
# Use --prefer-offline to reduce network overhead and memory usage
RUN npm install --prefer-offline --no-audit --progress=false \
    && npm rebuild rollup \
    && npm cache clean --force

# Copy source code
COPY . .

# Build the app with memory-efficient settings
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build \
    && rm -rf node_modules/.cache

# Production stage
FROM nginx:alpine

# Copy built files (Vite builds to 'dist' not 'build')
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
