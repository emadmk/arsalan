# Build stage
FROM node:18-alpine AS builder

WORKDIR /app

# Set Node.js memory limit to prevent OOM errors
ENV NODE_OPTIONS="--max-old-space-size=2048"

# Install build dependencies for native modules (required for rollup on Alpine)
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# Remove package-lock.json if exists (let npm create a fresh one for Alpine)
RUN rm -f package-lock.json

# Install dependencies - let npm figure out the best packages for Alpine musl
# This avoids the package-lock.json sync issues with optional dependencies
RUN npm install --no-audit --progress=false \
    && npm cache clean --force

# Copy source code
COPY . .

# Build the app with memory-efficient settings
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build \
    && rm -rf node_modules/.cache

# Production stage
FROM nginx:alpine

# Copy built files (Vite builds to 'dist' not 'build')
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
