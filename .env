# Persian Kerman Carpet - Environment Configuration

# Backend API URL
# Leave empty for production (uses nginx proxy)
# For local development: VITE_API_URL=http://localhost:5000
VITE_API_URL=

# Database Configuration
DB_PASSWORD=persian_carpet_secure_db_2024

# JWT Secret (change in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-$(date +%s)

# NOWPayments API Configuration
# Get your API key from https://nowpayments.io/
NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret_here

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# URLs (will be set by docker-compose based on your server)
# FRONTEND_URL will be auto-detected
# BACKEND_URL will use nginx proxy

# Admin Account
ADMIN_EMAIL=admin@persiancarpet.com
ADMIN_PASSWORD=Admin123!@#ChangeMe

# Server Port Configuration
PORT=5000
FRONTEND_PORT=5173
DB_PORT=5432
